{
  "name": "worktree-kanban",
  "version": "0.1.8",
  "description": "Desktop app that manages AI coding agent tasks (Claude Code / Codex CLI / Gemini CLI / Cursor CLI) on a kanban board and runs them in parallel, one git worktree each",
  "main": "main.js",
  "license": "MIT",
  "author": "kazuya83",
  "homepage": "https://github.com/kazuya83/worktree-kanban",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "prepare": "node scripts/setup-hooks.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.agentkanban.app",
    "productName": "Worktree Kanban",
    "artifactName": "worktree-kanban-${version}-${os}-${arch}.${ext}",
    "files": ["main.js", "preload.js", "src/**", "renderer/**"],
    "asarUnpack": ["src/permission-mcp.js", "renderer/i18n.js", "renderer/locales/**/*.js"],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "worktree-kanban-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "worktree-kanban-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "worktree-kanban-${version}-win-setup.${ext}"
    },
    "portable": {
      "artifactName": "worktree-kanban-${version}-win-portable.${ext}"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "category": "Development"
    }
  }
}
